<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Bearing fix — 2026-09-16 13:27/13:29</name>
  <description>Two Theodolite sightings reduced to an intersection. Rays drawn 450 m from each post.</description>

  <Style id="post">
    <IconStyle>
      <scale>1.0</scale>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/blu-circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><scale>0.9</scale></LabelStyle>
  </Style>

  <Style id="fix">
    <IconStyle>
      <scale>1.3</scale>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-stars.png</href></Icon>
    </IconStyle>
    <LabelStyle><scale>1.1</scale></LabelStyle>
  </Style>

  <Style id="ray">
    <LineStyle>
      <color>ff0095ff</color>
      <width>2.5</width>
    </LineStyle>
  </Style>

  <LookAt>
    <longitude>-97.113500</longitude>
    <latitude>31.547200</latitude>
    <altitude>0</altitude>
    <heading>0</heading>
    <tilt>0</tilt>
    <range>900</range>
    <altitudeMode>clampToGround</altitudeMode>
  </LookAt>

  <Folder>
    <name>Posts</name>

    <Placemark>
      <name>Spotter A — 13:29:28</name>
      <description>31.545604, -97.114565 — bearing 036 deg TRUE — 347 m to fix</description>
      <styleUrl>#post</styleUrl>
      <Point>
        <coordinates>-97.1145650,31.5456040,0</coordinates>
        <altitudeMode>clampToGround</altitudeMode>
      </Point>
    </Placemark>

    <Placemark>
      <name>Spotter B — 13:27:45</name>
      <description>31.546598, -97.115661 — bearing 061 deg TRUE — 352 m to fix</description>
      <styleUrl>#post</styleUrl>
      <Point>
        <coordinates>-97.1156610,31.5465980,0</coordinates>
        <altitudeMode>clampToGround</altitudeMode>
      </Point>
    </Placemark>

  </Folder>

  <Folder>
    <name>Sight lines</name>

    <Placemark>
      <name>Ray A — 036 deg</name>
      <styleUrl>#ray</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <altitudeMode>clampToGround</altitudeMode>
        <coordinates>
          -97.1145650,31.5456040,0
          -97.1117788,31.5488874,0
        </coordinates>
      </LineString>
    </Placemark>

    <Placemark>
      <name>Ray B — 061 deg</name>
      <styleUrl>#ray</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <altitudeMode>clampToGround</altitudeMode>
        <coordinates>
          -97.1156610,31.5465980,0
          -97.1115153,31.5485656,0
        </coordinates>
      </LineString>
    </Placemark>

  </Folder>

  <Placemark>
    <name>FIX — walk here</name>
    <description>31.548139, -97.112414
Rays cross at 25 deg. Range 347 m from Spotter A, 352 m from Spotter B.</description>
    <styleUrl>#fix</styleUrl>
    <Point>
      <coordinates>-97.1124140,31.5481390,0</coordinates>
      <altitudeMode>clampToGround</altitudeMode>
    </Point>
  </Placemark>

</Document>
</kml>
